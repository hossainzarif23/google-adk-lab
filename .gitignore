# Python bytecode and local interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local secrets and environment configuration
.env
.env.*
!.env.example

# ADK local session and runtime data
**/.adk/

# Test, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
